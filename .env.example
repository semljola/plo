# PLO local/test config
# Default points at the throwaway Postgres spun up for integration tests.
# For Supabase (EU / eu-north-1) set DATABASE_URL to the pooled connection string.
# Local default host:port/db = 127.0.0.1 : 55432 / plo (owner role "plo").
DATABASE_URL=postgresql://plo@127.0.0.1:55432/plo
PLO_REGION=eu-north-1

# Demo identity for the dashboard (set by scripts/seed-demo.mjs).
# PLO_DEMO_USER=
# PLO_DEMO_WORKSPACE=

# ---------------------------------------------------------------------------
# Live agent runner (optional). When PLO_AGENT_CMD is set, the build worker
# uses CommandAgentRunner: it writes the approved spec body as a brief, runs
# this command in PLO_AGENT_REPO (a real git repo), commits the result, and
# returns the real git SHA. Unset => the deterministic StubAgentRunner is used.
#
# Example once a coding agent CLI is installed (e.g. @anthropic-ai/claude-code):
#   PLO_AGENT_CMD=claude -p "$PLO_BRIEF" --allowedTools Read,Edit,Write --max-turns 20
#   PLO_AGENT_REPO=/absolute/path/to/the/target/repo
#   PLO_AGENT_TIMEOUT_MS=180000
# The command runs with cwd=PLO_AGENT_REPO and these env vars available:
#   PLO_BRIEF (JSON), PLO_BRIEF_FILE (path), PLO_SPEC_ID, PLO_SPEC_VERSION,
#   PLO_WORKSPACE_ID.
# PLO_AGENT_CMD=
# PLO_AGENT_REPO=
# PLO_AGENT_TIMEOUT_MS=120000
